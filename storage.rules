rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaffContentEditor() {
      return isAuthenticated() &&
        request.auth.token.role in ['admin', 'superadmin', 'associate'];
    }

    function isValidSize() {
      return request.resource.size < 100 * 1024 * 1024;
    }

    function isValidMeshAssetSize() {
      return request.resource.size < 500 * 1024 * 1024;
    }

    function isValidVr360VideoSize() {
      return request.resource.size < 2500 * 1024 * 1024;
    }

    match /lesson_assets/{assetId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isStaffContentEditor() && isValidSize();
    }

    match /meshy_assets/{assetId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isStaffContentEditor() && isValidMeshAssetSize();
    }

    match /text_to_3d_assets/{assetId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isStaffContentEditor() && isValidMeshAssetSize();
    }

    match /avatar_to_3d_assets/{assetId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isStaffContentEditor() && isValidMeshAssetSize();
    }

    match /chapter_images/{imageId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isStaffContentEditor() && isValidSize();
    }

    match /video_vr_tour/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isStaffContentEditor() && isValidVr360VideoSize();
    }

    match /pdfs/{pdfId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isStaffContentEditor() && isValidSize();
    }

    match /chapter_pdf/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if isStaffContentEditor() && isValidSize();
    }

    match /question_papers/{userId}/{allPaths=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isStaffContentEditor();
      allow write: if request.auth != null && request.auth.uid == userId && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /uploads/{userId}/{allPaths=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isStaffContentEditor();
      allow write: if request.auth != null && request.auth.uid == userId && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /n8n-builder/{userId}/{allPaths=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isStaffContentEditor();
      allow write: if request.auth != null && request.auth.uid == userId && isValidSize();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
  }
}
