	<scene name="scene_video_videoplayback" title="VR Demo (360°)" onstart="" thumburl="../LearnXR-website-main/img/lxrn5.png">
		<control bouncinglimits="false" />
		<view hlookat="0.0" vlookat="0.0" fovtype="MFOV" fov="110" maxpixelzoom="2.0" fovmin="70" fovmax="120" limitview="auto" />
		<preview url="../LearnXR-website-main/img/lxrn5.png" />

