# Client Environment Variables Template
# Copy this file to .env and fill in your actual values
# WARNING: VITE_* variables are bundled into production JS — never put server secrets here.

# API Configuration
VITE_API_URL=http://localhost:5002
VITE_USE_MESHY_PROXY=true

# Firebase Configuration (public web config only)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Route API calls through the site's own origin (/api) instead of the absolute
# cloudfunctions.net URL, so responses pass through the Hosting CDN and skip the
# cross-origin preflight.
#
# Only enable this for a site whose firebase config rewrites /api to the `api`
# function. Today that is firebase.json alone — firebase.lexrn1.json and
# firebase.preview.testing.json have only the SPA catch-all, so there /api would
# return index.html with a 200 and every API call would receive HTML.
VITE_API_SAME_ORIGIN=false
