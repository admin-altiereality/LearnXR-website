# Client Environment Variables Template
# Copy this file to .env and fill in your actual values
#
# For Firebase Hosting site "altiereality" on project "lexrn1", use .env.lexrn1.example → .env.lexrn1
# and build with: npm run build:lexrn1

# API Configuration
VITE_API_URL=http://localhost:5002
# Full API base for Firebase auth + routes (include /api). Local Express with Twilio inbox:
# VITE_API_BASE_URL=http://localhost:5002/api
VITE_MESHY_API_KEY=your_meshy_api_key_here

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
