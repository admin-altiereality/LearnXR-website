# Copy to ".env.lexrn1" (gitignored) before `npm run build:lexrn1` for Hosting site "altiereality".
#
# IMPORTANT — Firebase in the BROWSER (Auth / Firestore / Storage):
#   Use project learnxr-evoneuralai ONLY. Do NOT set VITE_FIREBASE_PROJECT_ID=lexrn1.
#   Put real VITE_FIREBASE_* values in .env (evoneuralai Web app), or duplicate them here.
#   Never use empty lines like VITE_FIREBASE_API_KEY= — they override .env and ship a broken build.
#
# Firebase Console: Authentication → Authorized domains must include altiereality.web.app
# and altiereality.firebaseapp.com.
#
# Backend `api` function: deploy on learnxr-evoneuralai (same as Auth). Hosting may be site "altiereality" on lexrn1.

VITE_API_URL=https://altiereality.web.app
VITE_API_BASE_URL=https://us-central1-learnxr-evoneuralai.cloudfunctions.net/api

# If you instead deploy `api` on lexrn1 and use Hosting /api rewrite to that project, use lexrn1 URL above and set:
# VITE_USE_HOSTING_API_REWRITE=true
# (Requires Secret LEARNXR_CLIENT_FIREBASE_SERVICE_ACCOUNT on lexrn1 for evoneuralai ID tokens.)

# n8n (optional client-side polling — prefer not to put API keys in the client for production)
VITE_N8N_WEBHOOK_URL=https://n8n.altiereality.com/webhook/b8608c3e
VITE_N8N_API_URL=https://n8n.altiereality.com
# VITE_N8N_API_KEY=

# Empty string = no same-origin /api proxy on static Hosting
VITE_API_PROXY_URL=

# Optional: JSON map of n8n node name -> pipeline step id (receive|extract|ai|topics|skybox|save)
# VITE_N8N_NODE_TO_STEP={"My Custom Node":"ai"}
