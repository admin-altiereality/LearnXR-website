# Server Environment Variables Template
# Copy this file to .env and fill in your actual values

# API Configuration
API_KEY=your_meshy_api_key_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Firebase Configuration (local server / scripts)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"
#
# Cloud Functions (project learnxr-evoneuralai): LEARNXR_CLIENT_FIREBASE_SERVICE_ACCOUNT in Secret Manager
# must be the learnxr-evoneuralai service account JSON (verifies browser tokens from that project).
# After setting the vars below in server/.env, run from repo root:
#   npm --prefix functions run secrets:push-learnxr-client
#   npm --prefix functions run deploy:evoneuralai
# Or full JSON / file path:
# LEARNXR_CLIENT_FIREBASE_SERVICE_ACCOUNT_FILE=C:/path/to/learnxr-evoneuralai-firebase-adminsdk-xxxx.json
# If FIREBASE_PROJECT_ID=learnxr-evoneuralai and the three Firebase lines above are filled, the push script builds the JSON automatically.

# Server Configuration
SERVER_PORT=5002
NODE_ENV=production

# n8n (automation) — see docs/altie-paperclip-n8n/SECURITY.md
N8N_API_URL=https://n8n.altiereality.com
N8N_API_KEY=
N8N_LEAD_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_PATH=learnxr-website-lead

# Paperclip bridge: POST /api/paperclip-n8n/trigger (Bearer PAPERCLIP_BRIDGE_SECRET)
PAPERCLIP_N8N_PUBLIC_BASE=https://n8n.altiereality.com
PAPERCLIP_BRIDGE_SECRET=
# Optional: defaults to server/config/paperclip-n8n-workflows.json
# PAPERCLIP_N8N_WORKFLOWS_PATH=

# Twilio WhatsApp + Conversations (inbox at /inbox/whatsapp)
# Webhook URL (public): POST https://<api-host>/api/webhooks/twilio/messaging
# Twilio Console: Account > API keys & tokens (standard API key for Conversations token minting).
# Conversations > Services — copy Service SID (IS...).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_CONVERSATIONS_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shared Twilio Conversations "user" for all staff (JWT + webhook participant). Default: learnxr_inbox_staff
# TWILIO_INBOX_CONVERSATIONS_IDENTITY=learnxr_inbox_staff
# Optional: only if Twilio docs specify a region for access tokens (e.g. ie1). Leave unset for default.
# On Cloud Functions `api`, set as an env var on the Cloud Run revision or add to secrets workflow if you use regional data.
# TWILIO_ACCESS_TOKEN_REGION=
#
# Optional: backend logs JWT claim shape after minting (jwt.decode, no verify). Never logs the full JWT or API secret.
# Set on Cloud Run for the `api` function or in server/.env for local Express. Values: true / unset.
# TWILIO_TOKEN_DEBUG_LOG=true
#
# If Auth Token can load the IS… service but the JS SDK still returns 20151, the API Key **secret** does not match SK…
# or the key was created on the **parent** account while AC… is a **subaccount** (create a new API key on that subaccount).
# Optional (local Express or Cloud Run env vars — not bound as Firebase secrets in code):
TWILIO_WHATSAPP_FROM=+918619953434
TWILIO_MESSAGING_SERVICE_SID=MG42e7fbd7bcaa5bd31d712d0897255742
# n8n URL for Conversations conversation-scoped webhooks (JSON). Apply with: powershell -File server/scripts/twilio-conversations-n8n-bypass.ps1
TWILIO_N8N_CONVERSATIONS_WEBHOOK_URL=
# Optional IGe…; bypass script can infer from TWILIO_WHATSAPP_FROM if there is a single matching Address Configuration
# TWILIO_CONVERSATIONS_ADDRESS_CONFIG_SID=
#
# Optional: after /api/webhooks/twilio/messaging processes a Conversations event, forward Programmable-Messaging-shaped
# fields (From, To, Body, ConversationSid, …) to this URL for n8n workflows that still expect classic inbound form POST.
# Leave unset if n8n already receives the same traffic from Twilio Address Configuration webhooks (avoid duplicates).
TWILIO_N8N_LEGACY_INBOUND_FORWARD_URL=
# Cloud Functions (learnxr-evoneuralai): create functions/.env.learnxr-evoneuralai with the same two keys;
# Firebase CLI loads it on deploy for defineString. File is gitignored.
#
# Deployed Cloud Function `api` (learnxr-evoneuralai): these five are read from Secret Manager.
# Create secrets in GCP first (CLI cannot deploy new secret names without values). From repo root:
#   npm --prefix functions run secrets:push-twilio
#   npm --prefix functions run deploy:api:evoneuralai
# (deploy:api:evoneuralai runs push + non-interactive deploy.) If push fails, fix server/.env then retry.
# Secrets already in Secret Manager: npm --prefix functions run deploy:api:evoneuralai:only
# Other Firebase project: node functions/scripts/set-twilio-secrets-from-env.mjs YOUR_PROJECT_ID
